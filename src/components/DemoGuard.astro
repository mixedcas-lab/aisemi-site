---
// 로그인 시안: 해당 역할로 "로그인"한 경우에만 본문을 보여 준다. 실제 인증이 아니다.
import { relativeRoot } from '../lib/paths';
const { role, label } = Astro.props;
const root = relativeRoot(Astro.url.pathname);
---
<div class="guard" data-demo-guard={role}>
  <div class="container section pending" data-guard-msg>
    <p class="pending-title">로그인이 필요합니다</p>
    <p>{label} 화면은 로그인 후 볼 수 있습니다.</p>
    <a class="btn" href={`${root}login/${role === 'staff' ? '#staff' : ''}`}>로그인하기</a>
  </div>
  <div data-guard-body hidden><slot /></div>
</div>
