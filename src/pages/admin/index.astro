---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import DemoGuard from '../../components/DemoGuard.astro';
import demo from '../../data/demo.json';
import programs from '../../data/programs.json';
import { adminTabs } from '../../lib/tabs';
import { relativeRoot } from '../../lib/paths';
import { range } from '../../lib/format';
const root = relativeRoot(Astro.url.pathname);
const year = Math.max(...programs.map((p) => p.year));
const waitingJoin = demo.joinRequests.filter((j) => j.status === '신청').length;
const notUpdated = demo.students.filter((s) => s.join === '승인' && !s.updated).length;
const waitlist = demo.roster.people.filter((p) => p.status === '대기').length;
const approved = demo.students.filter((s) => s.join === '승인').length;
const applied = Object.values(demo.programApplicants).reduce((a, b) => a + b, 0);
---
<Layout title="관리자 화면" crumbs={[['관리자 화면']]}>
  <DemoGuard role="staff" label="관리자">
    <PageHead eyebrow="ADMIN · 예시 데이터" title="관리자 화면" tabs={adminTabs} active="admin/" />
    <div class="container section dash">
      <section class="stats">
        <div class="stat"><span>참여 신청 대기</span><strong>{waitingJoin}</strong></div>
        <div class="stat"><span>{year}년 참여 승인</span><strong>{approved}</strong></div>
        <div class="stat"><span>{year}년 프로그램</span><strong>{programs.filter((p) => p.year === year).length}</strong></div>
        <div class="stat"><span>프로그램 신청 합계</span><strong>{applied}</strong></div>
      </section>
      <section class="panel">
        <h2>처리할 일</h2>
        <ul class="todo-list">
          <li class="todo todo-warn"><span><strong>참여 신청 {waitingJoin}건</strong>이 승인을 기다리고 있습니다.</span><a class="btn-sm" href={`${root}admin/join/`}>처리하기</a></li>
          <li class="todo todo-warn"><span>승인 학생 중 <strong>{notUpdated}명</strong>이 2학기 학적 정보를 갱신하지 않았습니다.</span><a class="btn-sm" href={`${root}admin/stats/#mail`}>안내 메일 보내기</a></li>
          <li class="todo todo-info"><span>「{programs.find((p) => p.id === demo.roster.program)?.title}」 대기자 <strong>{waitlist}명</strong>의 선발 여부를 정해 주세요.</span><a class="btn-sm" href={`${root}admin/programs/`}>선발하기</a></li>
          <li class="todo todo-info" data-closing-soon data-ranges={programs.map((p) => p.recruit.join("|")).join(",")} hidden><span>모집 마감이 7일 이내인 프로그램이 있습니다.</span><a class="btn-sm" href={`${root}admin/programs/`}>확인</a></li>
        </ul>
      </section>
      <section class="panel">
        <h2>진행 중·예정 교육</h2>
        <ul class="mini-list">
          {programs.map((p) => <li><a href={`${root}programs/${p.id}/`}>{p.title}</a><span class="muted">{range(p.period)}</span></li>)}
        </ul>
      </section>
    </div>
  </DemoGuard>
</Layout>
