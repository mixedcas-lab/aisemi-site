---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import DemoGuard from '../../components/DemoGuard.astro';
import demo from '../../data/demo.json';
import programs from '../../data/programs.json';
import { adminTabs } from '../../lib/tabs';
import { studentById, programById } from '../../lib/demo';
import { relativeRoot } from '../../lib/paths';
import { recruitState, recruitLabel } from '../../lib/format';
const root = relativeRoot(Astro.url.pathname);
const r = demo.roster;
const p = programById[r.program];
const need = Math.ceil(r.sessions * 0.75);
---
<Layout title="프로그램 운영" crumbs={[['관리자 화면', 'admin/'], ['프로그램 운영']]}>
  <DemoGuard role="staff" label="관리자">
    <PageHead eyebrow="ADMIN · 예시 데이터" title="프로그램 운영" lead="선발·대기·이수 처리는 이 화면에서만 바뀝니다." tabs={adminTabs} active="admin/programs/" />
    <div class="container section dash">
      <section class="panel">
        <div class="panel-head"><h2>프로그램별 신청 현황</h2><button class="btn btn-line" type="button" data-mock>프로그램 추가</button></div>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th>프로그램</th><th>단계</th><th>모집</th><th>신청 / 정원</th><th class="actions"></th></tr></thead>
            <tbody>
              {programs.map((x) => { const st = recruitState(x.recruit); return (
                <tr>
                  <td><a href={`${root}programs/${x.id}/`}>{x.title}</a></td><td>{x.level}</td>
                  <td><span class="status" data-recruit={x.recruit.join('|')} data-state={st}>{recruitLabel[st]}</span></td>
                  <td class="num">{demo.programApplicants[x.id]} / {x.capacity}</td>
                  <td class="actions">{x.id === r.program ? <a class="btn-sm" href="#roster">신청자 관리</a> : <button class="btn-sm btn-sm-line" type="button" data-mock>신청자 관리</button>}</td>
                </tr>); })}
            </tbody>
          </table>
        </div>
      </section>
      <section class="panel" id="roster">
        <div class="panel-head"><h2>「{p.title}」 신청자 <span class="muted">예시 {r.people.length}명 · 총 {r.sessions}회차</span></h2><button class="btn btn-line" type="button" data-mock>출석부 내려받기</button></div>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th>이름</th><th>참여 동기</th><th>출석</th><th>상태</th><th class="actions">처리</th></tr></thead>
            <tbody>
              {r.people.map((x) => { const s = studentById[x.student]; return (
                <tr data-row>
                  <td>{s.name}</td><td class="motive">{x.motive}</td>
                  <td class="num"><span class:list={['attend', { low: x.attend < need }]}>{x.attend} / {r.sessions}</span></td>
                  <td><span class="state" data-state={x.status === '선발' ? '승인' : x.status === '대기' ? '신청' : x.status} data-cell-status>{x.status}</span></td>
                  <td class="actions"><button class="btn-sm" type="button" data-set-status="선발">선발</button><button class="btn-sm btn-sm-line" type="button" data-set-status="대기">대기</button><button class="btn-sm btn-sm-line" type="button" data-set-status="이수" disabled={x.attend < need}>이수 처리</button></td>
                </tr>); })}
            </tbody>
          </table>
        </div>
        <p class="muted">예시 규칙: 출석 {need}회({Math.round(need / r.sessions * 100)}%) 이상이어야 이수 처리할 수 있습니다. 실제 이수 규칙은 사업단이 정합니다.</p>
      </section>
    </div>
  </DemoGuard>
</Layout>
