---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import NoticeList from '../components/NoticeList.astro';
import notices from '../data/notices.json';
---
<Layout title="사업단 소식" crumbs={[['사업단 소식']]}>
  <PageHead eyebrow="NEWS" title="사업단 소식" tabs={[['공지사항', 'notices/'], ['사업단 소식', 'news/']]} active="news/" />
  <NoticeList items={notices.filter((n) => n.board === 'news')} label="소식" />
</Layout>
